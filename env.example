# Environment Variables Template
# Copy this file to .env.local and fill in the values

# ===== Supabase CRM =====
NEXT_PUBLIC_SUPABASE_CRM_URL=https://avfcsuyackxiaglldyvo.supabase.co
NEXT_PUBLIC_SUPABASE_CRM_ANON_KEY=your_crm_anon_key

# service_role key do MESMO projeto CRM acima (Supabase → Project Settings →
# API → service_role, secret). NUNCA prefixar com NEXT_PUBLIC_ — só usada
# server-side pela rotina de backup diária (src/app/api/cron/backup).
SUPABASE_CRM_SERVICE_ROLE_KEY=your_crm_service_role_key

# Secret aleatório qualquer (ex: gerar com `openssl rand -hex 32`) — protege
# a rota /api/cron/backup contra chamada por qualquer um que descubra a URL.
# O Vercel Cron manda esse valor sozinho no header Authorization quando essa
# env var está configurada no projeto.
CRON_SECRET=your_random_secret

# ===== Supabase Site (formulario /contato) =====
NEXT_PUBLIC_SUPABASE_URL=https://isrqhxhoabxkpunmbxti.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_site_anon_key

# ===== Analytics =====
NEXT_PUBLIC_FACEBOOK_PIXEL_ID=your_pixel_id

# NOTA (2026-06-23 auditoria): as seguintes variaveis foram REMOVIDAS deste template
# porque o codigo que as usava foi deletado (codigo morto):
#   - SUPABASE_SERVICE_ROLE_KEY (voucher.ts/products-server.ts apagados)
#   - NEXT_PUBLIC_GEMINI_API_KEY (gemini.ts apagado)
#   - UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN (rate-limit.ts nao usado em prod)
#   - TWILIO_ACCOUNT_SID / TWILIO_AUTH_TOKEN / TWILIO_WHATSAPP_FROM (useWhatsAppLead apagado)
#   - WEBHOOK_ORIGIN (rotas /api/vouchers/* nao existem)
# Se voce for usar qualquer um desses servicos, reative o codigo correspondente
# e adicione a variavel de volta aqui.
